# Build-time configuration for production builds (`next build`,
# `npm run build:cloudflare`). Tracked in git on purpose.
#
# NEXT_PUBLIC_* values are inlined into the client bundle by Next.js at build
# time. A Worker runtime binding of the same name in wrangler.toml is NOT visible
# to the browser bundle. The browser never calls the backend directly: the /agent
# page talks same-origin to the /api/agent proxy (see AGENT_API_BASE in
# src/app/agent/page.tsx), and this file configures that server-side proxy via
# getBackendUrl (src/lib/backend-url.ts) to reach the real backend.
#
# NEXT_PUBLIC_* values are public by definition. Never add server-side secrets.
NEXT_PUBLIC_BACKEND_URL=https://gmruxxvvxbypxv4d74kix7l6aq0ppwmd.lambda-url.us-east-1.on.aws
NEXT_PUBLIC_API_URL=https://hulchul-frontend.sufiyanx.workers.dev
