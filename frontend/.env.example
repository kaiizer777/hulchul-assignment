# Local development template. Copy to .env.local and adjust.
#
# NOTE: NEXT_PUBLIC_* values here are inlined into the client bundle at BUILD
# time, so they are not read at runtime by the deployed Worker. The deployed
# Worker gets its backend URL from frontend/.env.production, which is tracked in
# git — read server-side by getBackendUrl for the same-origin /api/agent proxy
# (the browser never calls the backend host directly). Values in wrangler.toml
# [vars] are runtime Worker bindings and are NOT visible to the browser bundle.
DATABASE_URL="postgresql://username:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# The deployed Worker does NOT read DATABASE_URL from this file. .env.local and
# .env.example are local-only; the Worker reads process.env, which is populated
# from Wrangler vars and secrets. Provision it on the Worker out of band, because a
# secret in wrangler.toml is committed to git and this value carries the Neon
# account password:
#
#   cd frontend
#   npx wrangler secret put DATABASE_URL
#
# `npm run deploy:cloudflare` refuses to upload unless DATABASE_URL and
# UPSTASH_REDIS_REST_TOKEN are both present on the Worker
# (scripts/verify-worker-secrets.mjs).

# Backend base URL. For local development, run the FastAPI backend on port 8051.
NEXT_PUBLIC_BACKEND_URL="http://localhost:8051"

# ERP frontend base URL the backend navigates the remote browser to.
NEXT_PUBLIC_API_URL="http://localhost:3051"