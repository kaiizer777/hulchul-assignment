DATABASE_URL="postgresql://username:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
BROWSER_WS_ENDPOINT="wss://connect.steel.dev?apiKey=your_steel_api_key_here"
GROQ_API_KEY="gsk_your_groq_api_key_here"
# OpenCode Zen LLM Settings (Primary)
OPENCODE_API_KEY="oc_sk_your_opencode_api_key_here"
OPENCODE_BASE_URL="https://opencode.ai/zen/v1"
OPENCODE_MODEL="space-bunny-free"
UPSTASH_REDIS_REST_URL="https://your-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_redis_token_here"
# ERP frontend base URL the backend navigates the remote browser to in local dev.
ERP_BASE_URL="http://localhost:3051"
FRONTEND_URL="http://localhost:3051"
NEXT_PUBLIC_API_URL="http://localhost:3051"
PORT="8051"
# Exact origins only. Wildcards are rejected; `*` is invalid with credentials.
CORS_ORIGINS="http://localhost:3051,http://127.0.0.1:3051,https://hulchul-frontend.sufiyanx.workers.dev"
# argon2id PHC string. Leave empty and every login attempt returns 503.
# Generate with: python -c "from argon2 import PasswordHasher; print(PasswordHasher().hash('your-password'))"
AUTH_PASSWORD_HASH="$argon2id$v=19$m=65536,t=3,p=4$replace_with_salt$replace_with_hash"
AUTH_SESSION_TTL_SECONDS="86400"
# Plaintext service credential for the agent backend's own browser session. Must be
# the password behind AUTH_PASSWORD_HASH: the agent logs into the ERP with it exactly
# like a user (real session cookie, normal middleware pass). Leave empty to disable.
AUTH_AGENT_PASSWORD=""
# Exposes /docs, /redoc and /openapi.json. Those routes are outside the session
# guard and list every endpoint to anonymous callers, so keep this false in production.
ENABLE_API_DOCS="false"
# Postgres run lease. RUN_LEASE_SECONDS must stay strictly above PAUSE_TIMEOUT_SECONDS
# or startup reconciliation will fail a run that is legitimately paused on a human;
# backend/config.py refuses to load if that is violated. The heartbeat renews the lease
# out-of-band because a single agent iteration can outlast any interval driven from
# inside the loop.
RUN_LEASE_SECONDS="900.0"
RUN_HEARTBEAT_SECONDS="60.0"
